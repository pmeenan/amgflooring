---
import Layout from '../layouts/Layout.astro';
import { Award, Clock, ThumbsUp, Shield } from 'lucide-react';
---

<Layout title="About Us">
  <div class="bg-navy py-16 md:py-24 pt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">About AMG Flooring</h1>
      <p class="text-xl text-slate-300 max-w-4xl mx-auto">Two decades of dedication to the craft of custom flooring and remodeling.</p>
    </div>
  </div>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <div>
          <h2 class="text-3xl font-display font-bold text-navy mb-6">Meet Armend Gashi</h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            With over 20 years of hands-on experience in the flooring industry, Armend Gashi founded AMG Flooring LLC with a singular vision: to bring unparalleled craftsmanship and integrity to homeowners across Northern Virginia.
          </p>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            What started as an apprenticeship in traditional hardwood installation has grown into a master-level understanding of all flooring types—from classic solid wood and durable LVP, to precise tile work and full bathroom remodeling. At AMG Flooring, we don't just lay floors; we build the foundation of your home's aesthetic and comfort.
          </p>

          <div class="grid grid-cols-2 gap-6 mt-10 text-slate-700">
            <div class="flex flex-col items-center p-4 bg-slate-50 rounded-lg text-center">
              <Award className="w-8 h-8 text-warm-oak mb-3" />
              <span class="font-bold text-navy">Master Craftsmanship</span>
            </div>
            <div class="flex flex-col items-center p-4 bg-slate-50 rounded-lg text-center">
              <Clock className="w-8 h-8 text-warm-oak mb-3" />
              <span class="font-bold text-navy">20+ Years Exp.</span>
            </div>
            <div class="flex flex-col items-center p-4 bg-slate-50 rounded-lg text-center">
              <Shield className="w-8 h-8 text-warm-oak mb-3" />
              <span class="font-bold text-navy">Licensed & Insured</span>
            </div>
            <div class="flex flex-col items-center p-4 bg-slate-50 rounded-lg text-center">
              <ThumbsUp className="w-8 h-8 text-warm-oak mb-3" />
              <span class="font-bold text-navy">100% Satisfaction</span>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden shadow-xl border border-slate-100">
            {/* Placeholder for Armend's photo */}
            <div class="w-full h-full bg-slate-200 flex items-center justify-center relative">
               <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1588612716168-f9bbee0739ba?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')] bg-cover bg-center mix-blend-overlay opacity-80"></div>
                <span class="relative z-10 text-navy/50 font-bold text-2xl">[Owner Photo Placeholder]</span>
            </div>
          </div>
          {/* Decorative element */}
          <div class="absolute -z-10 bottom-10 -right-10 w-full h-full bg-warm-oak/20 rounded-2xl"></div>
        </div>

      </div>
    </div>
  </section>

</Layout>
