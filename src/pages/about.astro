---
import Layout from '../layouts/Layout.astro';
import { Award, Clock, ThumbsUp, Shield } from 'lucide-react';
---

<Layout title="About Us">
  <div class="bg-navy py-16 md:py-24 pt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">About AMG Flooring</h1>
      <p class="text-xl text-slate-300 max-w-4xl mx-auto">Decades of dedication to the craft of custom flooring and remodeling.</p>
    </div>
  </div>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="text-center mb-12">
          <h2 class="text-3xl font-display font-bold text-navy mb-6">Meet The Team</h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            AMG Flooring LLC isn't just about floors; it's about comprehensive home transformation. We are proud to work with an excellent, hand-picked set of craftsmen whose collective expertise spans decades. 
          </p>
          <p class="text-lg text-slate-600 leading-relaxed">
            By bringing together specialized trades under one unified vision, we ensure that every aspect of your remodel is executed to the highest standards, without the headache of managing multiple independent contractors.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 text-slate-700">
          
          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex items-start">
            <Award className="w-10 h-10 text-warm-oak mr-5 flex-shrink-0" />
            <div>
              <h3 class="font-bold text-navy text-xl mb-2">Master Flooring Installers</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Specializing in intricate hardwood installations, dustless sanding, custom staining, and flawless LVP/LVT applications. Our flooring team sets the foundational standard for every project.</p>
            </div>
          </div>

          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex items-start">
            <ThumbsUp className="w-10 h-10 text-warm-oak mr-5 flex-shrink-0" />
            <div>
              <h3 class="font-bold text-navy text-xl mb-2">Tile Artisans</h3>
              <p class="text-slate-600 text-sm leading-relaxed">From large-format porcelain to mosaic shower pans, our tile setters bring absolute precision and perfect slopes to your custom bathroom and kitchen remodels.</p>
            </div>
          </div>

          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex items-start">
            <Shield className="w-10 h-10 text-warm-oak mr-5 flex-shrink-0" />
            <div>
              <h3 class="font-bold text-navy text-xl mb-2">Licensed Electricians</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Ensuring all wiring, custom lighting installations, and heated flooring systems are integrated safely, seamlessly, and perfectly to code.</p>
            </div>
          </div>

          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex items-start">
            <Clock className="w-10 h-10 text-warm-oak mr-5 flex-shrink-0" />
            <div>
              <h3 class="font-bold text-navy text-xl mb-2">Expert Plumbers</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Handling complex bathroom re-configurations, modern fixture installations, and behind-the-wall infrastructure so your water systems perform flawlessly for years to come.</p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

</Layout>
