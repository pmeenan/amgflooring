---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

// Sort by order manually added, or default to title sorting
services.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});
---

<Layout 
  title="Services"
  description="Explore our flooring and remodeling services in Northern Virginia. We specialize in hardwood repairs, dustless sanding, waterproof LVP, carpet installation, and full bathroom renovations in Fairfax, Loudoun, Prince William, Manassas, Ashburn, and surrounding areas."
>
  <div class="bg-navy py-16 md:py-24 pt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto">Expert installation and remodeling, tailored to elevate your living space.</p>
    </div>
  </div>

  <section class="py-20 bg-off-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {services.length === 0 ? (
        <div class="text-center py-20 text-slate-500">
           <p>No services content found yet. Add Markdown files to `src/content/services`.</p>
        </div>
      ) : (
        services.map(async (service, index) => {
          const { Content } = await service.render();
          const isEven = index % 2 === 0;
          
          return (
            <div id={service.slug} class={`flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden`}>
              
              <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
                <h2 class="text-3xl font-display font-bold text-navy mb-4">{service.data.title}</h2>
                <p class="text-slate-600 mb-6 text-lg">{service.data.description}</p>
                
                <div class="prose prose-slate max-w-none text-slate-600 prose-p:mb-4 prose-ul:list-disc prose-ul:pl-5 prose-li:mb-1">
                  <Content />
                </div>
                
                <div class="mt-8 pt-6 border-t border-slate-100">
                  <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 border border-transparent shadow-sm text-base font-medium rounded-md text-white bg-warm-oak hover:bg-[#c2a38c] transition-colors">
                    Request an Estimate
                  </a>
                </div>
              </div>

              <div class="md:w-1/2 min-h-[300px] relative overflow-hidden">
                {service.data.image ? (
                  <div class="absolute inset-0 bg-slate-100">
                    <img src={service.data.image} alt={service.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform hover:scale-105 duration-700" />
                  </div>
                ) : (
                  <div class="absolute inset-0 bg-navy/5 flex items-center justify-center">
                     <span class="text-slate-400 font-medium">[{service.data.title} Image]</span>
                  </div>
                )}
              </div>

            </div>
          );
        })
      )}

    </div>
  </section>
</Layout>
