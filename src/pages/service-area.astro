---
import Layout from '../layouts/Layout.astro';
import { MapPin, CheckCircle } from 'lucide-react';

const serviceAreas = [
  'Fairfax County',
  'Arlington County',
  'Alexandria City',
  'Loudoun County',
  'Prince William County',
  'Fairfax',
  'Manassas',
  'Gainesville',
  'Ashburn',
  'Falls Church',
  'McLean',
  'Vienna',
  'Oakton',
  'Reston',
  'Herndon',
  'Centreville'
];
---

<Layout 
  title="Service Area"
  description="AMG Flooring LLC brings our mobile showroom to your door. We serve Fairfax County, Arlington, Alexandria, Loudoun County, Prince William County, Manassas, Gainesville, Ashburn, McLean, Vienna, Reston, and the greater DC Metro Area."
>
  <div class="bg-navy py-16 md:py-24 pt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Our Service Area</h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto flex items-center justify-center">
        <MapPin className="w-5 h-5 mr-2 text-warm-oak" /> Serving Northern Virginia & the DC Metro Area
      </p>
    </div>
  </div>

  <section class="py-20 bg-off-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        
        {/* Areas List */}
        <div class="bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-slate-100">
          <h2 class="text-3xl font-display font-bold text-navy mb-6">Proudly serving local communities</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">
            AMG Flooring LLC brings our mobile showroom and expert installation teams directly to your door across Northern Virginia. We understand the specific flooring needs and architectural styles of our region.
          </p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
            {serviceAreas.map(area => (
              <div class="flex items-start text-slate-700 font-medium">
                <CheckCircle className="w-5 h-5 text-warm-oak mr-3 flex-shrink-0 mt-0.5" />
                <span class="break-words leading-tight">{area}</span>
              </div>
            ))}
          </div>

          <div class="mt-10 p-6 bg-slate-50 border border-slate-200 rounded-xl">
            <h3 class="font-bold text-navy text-lg mb-2">Don't see your city?</h3>
            <p class="text-slate-600 text-sm mb-4">We frequently travel throughout the greater DMV area for larger projects.</p>
            <a href="/contact" class="text-warm-oak font-semibold hover:text-navy transition-colors">
              Contact us to check availability &rarr;
            </a>
          </div>
        </div>

        {/* Map Visuals */}
        <div class="sticky top-28 bg-white p-4 rounded-2xl shadow-sm border border-slate-100 h-[600px] flex items-center justify-center overflow-hidden">
          {/* Embedded map centered perfectly to show Loudoun, Fairfax, and Prince William Counties */}
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d401340.23122176377!2d-77.53428283256059!3d38.826721538350114!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" 
            width="100%" 
            height="100%" 
            style="border:0; border-radius: 0.75rem;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

      </div>
    </div>
  </section>

</Layout>
