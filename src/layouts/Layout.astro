---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "AMG Flooring LLC - Expert Hardwood, LVP, LVT, Carpet & Remodeling in Northern Virginia" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		{/* Open Graph / Local SEO tags */}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} | AMG Flooring LLC`} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="AMG Flooring LLC - Northern Virginia" />
		<meta name="keywords" content="flooring, hardwood, LVP, LVT, carpet installation, bathroom remodeling, Fairfax, Loudoun, Prince William, Manassas, Arlington, Alexandria, Ashburn, Virginia" />
		
		<title>{title} | AMG Flooring LLC</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
