---
import { Star } from 'lucide-react';

const testimonials = [
  {
    name: "Sarah Jenkins",
    location: "Ashburn, VA",
    text: "AMG Flooring transformed our entire main level. They removed the old carpet and installed beautiful solid oak flooring. The crew was professional, always on time, and left our house spotless every day.",
    rating: 5
  },
  {
    name: "David Chen",
    location: "Fairfax, VA",
    text: "We hired Armend to remodel our master bathroom and the results are stunning. His tile work is absolute perfection, and the pricing was very fair for the incredible quality we received.",
    rating: 5
  },
  {
    name: "Michael Peterson",
    location: "Manassas, VA",
    text: "I highly recommend AMG for LVP installation. They installed over 1,500 sq ft in our basement in just two days. It looks amazing and has totally held up to our dogs and kids.",
    rating: 5
  }
];
---

<section class="py-24 bg-off-white relative overflow-hidden">
  {/* Abstract Background pattern */}
  <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, black 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold text-warm-oak uppercase tracking-wider mb-2">Client Success</h2>
      <h3 class="text-3xl md:text-5xl font-display font-bold text-navy mb-4">What Our Clients Are Saying</h3>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">Don't just take our word for it—read about the experiences of homeowners across Northern Virginia who chose AMG Flooring for their transformations.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-xl transition-shadow duration-300 flex flex-col h-full transform hover:-translate-y-1">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 rounded-full bg-navy text-white flex items-center justify-center font-display font-bold text-xl mr-4 flex-shrink-0">
              {t.name.charAt(0)}
            </div>
            <div>
              <div class="font-bold text-navy text-lg">{t.name}</div>
              <div class="text-sm text-slate-500">{t.location}</div>
            </div>
          </div>
          
          <div class="flex text-yellow-500 mb-6">
            {[...Array(t.rating)].map((_) => (
              <Star className="w-5 h-5 fill-current" />
            ))}
          </div>
          
          <blockquote class="text-slate-600 text-lg leading-relaxed flex-grow italic relative">
            <span class="absolute -top-4 -left-2 text-6xl text-slate-200 font-serif leading-none opacity-50">"</span>
            <span class="relative z-10">{t.text}</span>
          </blockquote>
        </div>
      ))}
    </div>
  </div>
</section>
