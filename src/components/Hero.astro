---
import { ArrowRight, Star } from 'lucide-react';
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-navy">
  {/* Background Pattern */}
  <div class="absolute inset-0 z-0 opacity-40">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light/90 to-transparent z-10"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-center">
      
      {/* Text Content Block */}
      <div class="sm:text-center md:max-w-2xl md:mx-auto lg:col-span-6 lg:text-left">
        <div class="inline-flex items-center space-x-2 bg-warm-oak/20 text-warm-oak px-4 py-1.5 rounded-full text-sm font-medium mb-6 border border-warm-oak/30 backdrop-blur-sm">
          <Star className="w-4 h-4 fill-warm-oak" />
          <span>Over 20 Years of Craftsmanship</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl font-display font-bold text-white leading-tight mb-6">
          Expert Flooring & <br/>Remodeling in <span class="text-warm-oak leading-tight block mt-2">Northern Virginia</span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed">
          Elevate your home with premium hardwood, LVP, LVT, carpeting, and custom bathroom remodeling by AMG Flooring LLC. Unmatched quality, guaranteed.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/contact" class="bg-warm-oak hover:bg-white text-navy font-semibold px-8 py-4 rounded-md text-center transition-all duration-300 shadow-xl shadow-warm-oak/20 flex items-center justify-center group">
            Get a Free Estimate
            <ArrowRight className="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="/gallery" class="bg-white/10 hover:bg-white/20 text-white font-medium px-8 py-4 rounded-md text-center backdrop-blur-sm border border-white/20 transition-all duration-300">
            View Our Work
          </a>
        </div>
      </div>

      {/* Image Block (Hidden on smaller screens, shown on lg and up) */}
      <div class="hidden lg:block lg:col-span-6 relative mt-12 lg:mt-0">
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-white/10">
           <div class="absolute inset-0 bg-[url('/images/hero-image.jpg')] bg-cover bg-center transition-transform hover:scale-105 duration-700"></div>
           <div class="absolute inset-0 bg-navy/10 mix-blend-overlay"></div>
        </div>
        {/* Decorative elements behind the image */}
        <div class="absolute -top-6 -right-6 w-full h-full border-4 border-warm-oak/30 rounded-2xl -z-10"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-warm-oak/20 rounded-full blur-3xl -z-10"></div>
      </div>

    </div>
  </div>
  
  {/* Bottom decorative wave or fade */}
  <div class="absolute bottom-0 w-full h-24 bg-gradient-to-t from-off-white to-transparent z-10 pointer-events-none"></div>
</section>
