---
import { Phone, Mail, Menu, X } from 'lucide-react';
---

<header class="fixed w-full top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100 transition-all duration-300" id="main-header">
  <div class="bg-navy text-off-white text-xs py-2 hidden md:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <a href="tel:5712859450" class="flex items-center hover:text-warm-oak transition-colors">
          <Phone className="w-3.5 h-3.5 mr-2" />
          (571) 285-9450
        </a>
        <a href="mailto:gashi709@hotmail.com" class="flex items-center hover:text-warm-oak transition-colors">
          <Mail className="w-3.5 h-3.5 mr-2" />
          gashi709@hotmail.com
        </a>
      </div>
      <div>
        <span>Serving Northern Virginia & DC Metro Area</span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="font-display font-bold text-2xl text-navy tracking-tight">
          AMG <span class="text-warm-oak">Flooring</span>
        </a>
      </div>
      
      {/* Desktop Nav */}
      <nav class="hidden md:flex space-x-8">
        {[
          ['Home', '/'],
          ['About Us', '/about'],
          ['Services', '/services'],
          ['Service Area', '/service-area'],
          ['Gallery', '/gallery'],
        ].map(([title, url]) => (
          <a href={url} class="text-sm font-medium text-slate-700 hover:text-navy hover:bg-slate-50 px-3 py-2 rounded-md transition-colors">
            {title}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center">
        <a href="/contact" class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-md text-sm font-medium transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
          Get a Quote
        </a>
      </div>

      {/* Mobile menu button */}
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-slate-700 hover:text-navy focus:outline-none p-2" aria-label="Menu">
          <Menu className="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Nav */}
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 absolute w-full shadow-xl">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {[
        ['Home', '/'],
        ['About Us', '/about'],
        ['Services', '/services'],
        ['Service Area', '/service-area'],
        ['Gallery', '/gallery'],
        ['Contact Us', '/contact'],
      ].map(([title, url]) => (
        <a href={url} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-navy hover:bg-slate-50">
          {title}
        </a>
      ))}
      <div class="pt-4 pb-2 border-t border-slate-100 px-3">
         <p class="text-sm text-slate-500 mb-2">Contact Us Directly:</p>
         <a href="tel:5712859450" class="flex items-center text-navy font-medium mb-2">
            <Phone className="w-4 h-4 mr-2 text-warm-oak" />
            (571) 285-9450
          </a>
          <a href="mailto:gashi709@hotmail.com" class="flex items-center text-navy font-medium">
            <Mail className="w-4 h-4 mr-2 text-warm-oak" />
            gashi709@hotmail.com
          </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
